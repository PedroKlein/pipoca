{
  "name": "pipoca",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*",
    "examples"
  ],
  "scripts": {
    "build": "bun run --cwd apps/pipoca build",
    "dev": "bun run --cwd apps/pipoca dev",
    "smoke": "bun run --cwd apps/pipoca smoke",
    "format": "prettier --write .",
    "registries": "bun apps/pipoca/src/registries.ts",
    "format:check": "prettier --check .",
    "lint": "eslint . --ignore-pattern 'apps/web/**' --ignore-pattern 'examples/**' --max-warnings 0 && eslint apps/web examples --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web && tsc --noEmit -p packages/ui/web && tsc --noEmit -p packages/plugins/web && tsc --noEmit -p plugins/checklist/web && tsc --noEmit -p plugins/changes/web && tsc --noEmit -p plugins/git-hosts/web && tsc --noEmit -p plugins/oidc/web && tsc --noEmit -p plugins/routines/web && tsc --noEmit -p plugins/subagents/web && tsc --noEmit -p examples",
    "test:e2e": "bun test ./apps/pipoca/src/web.e2e.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "^1.4.3",
    "bun-plugin-tailwind": "0.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2"
  }
}
