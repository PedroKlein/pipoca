{
  "name": "@pipoca/logins",
  "private": true,
  "type": "module",
  "exports": {
    "./server": "./src/server.ts",
    "./session": "./src/session.ts",
    "./web": "./web/index.tsx",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "@pipoca/plugins": "workspace:*",
    "@pipoca/protocol": "workspace:*",
    "@pipoca/ui": "workspace:*",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0"
  },
  "pipoca": {
    "id": "logins",
    "title": "Logins",
    "description": "Keeps each person's model provider and MCP server logins on the server, so their Sessions use them on every runner. Log in once with /login or /mcp login in any Session.",
    "capabilities": [
      "routes",
      "models",
      "profiles",
      "sessions",
      "events"
    ],
    "works": [
      "personal",
      "team"
    ]
  }
}
