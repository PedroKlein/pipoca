{
  "name": "@pipoca/meta",
  "private": true,
  "type": "module",
  "exports": {
    "./server": "./src/server.ts",
    "./session": "./src/session.ts",
    "./web": "./web/index.tsx",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@pipoca/plugins": "workspace:*",
