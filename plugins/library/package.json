{
  "name": "@pipoca/library",
  "private": true,
  "type": "module",
  "exports": {
    "./model": "./src/model.ts",
    "./server": "./src/server.ts",
    "./session": "./src/session.ts",
    "./web": "./web/index.tsx",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@pipoca/plugins": "workspace:*",
    "@pipoca/protocol": "workspace:*",
    "@pipoca/ui": "workspace:*",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0"
  },
  "pipoca": {
    "id": "library",
    "title": "Library",
    "description": "Files that every Session in a Project can read and add to.",
    "settings": {
      "fileLimitMb": {
        "type": "number",
        "title": "File size limit in MB",
        "description": "The largest file a user or a Session can add to a Project's library.",
        "default": 10,
        "min": 1,
        "max": 100
      }
    },
    "capabilities": [
      "events",
      "sessions",
      "routes"
    ],
    "works": [
      "personal",
      "team"
    ]
  }
}
