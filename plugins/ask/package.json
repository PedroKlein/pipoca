{
  "name": "@pipoca/ask",
  "private": true,
  "type": "module",
  "exports": {
    "./session": "./src/session.ts",
    "./server": "./src/server.ts",
    "./web": "./web/index.tsx",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@pipoca/plugins": "workspace:*",
    "@pipoca/protocol": "workspace:*",
    "@pipoca/ui": "workspace:*",
    "react": "19.3.1"
  },
  "pipoca": {
    "id": "ask",
    "title": "Ask",
    "description": "Lets the agent ask you structured questions in a form, and the team vote.",
    "capabilities": [
      "tools",
      "routes",
      "sessions"
    ],
    "settings": {
      "voteMinutes": {
        "type": "number",
        "title": "Minutes a vote stays open",
        "description": "In team work, how long a vote waits before it closes by itself, unless whoever opens it says otherwise.",
        "default": 60,
        "min": 1,
        "max": 10080
      }
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0"
  }
}
