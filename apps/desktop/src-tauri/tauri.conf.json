{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pipoca",
  "version": "../../pipoca/package.json",
  "identifier": "dev.pipoca.desktop",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "bun sidecar.ts",
    "beforeBuildCommand": "bun sidecar.ts"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage"],
    "category": "DeveloperTool",
    "externalBin": ["binaries/pipoca"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["pipoca"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2M0RGQjNCRkI2MDkzNUMKUldSY2syRDdPL3M5MWdSUWpoR1Z5cUtmRE1LOUN2ckliamkzU3FuaHR6ZldRLzFZN3U0YTUzckQK",
      "endpoints": [
        "https://github.com/PedroKlein/pipoca/releases/latest/download/latest.json"
      ]
    }
  }
}
