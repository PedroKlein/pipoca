{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pipoca",
  "version": "0.1.0",
  "identifier": "dev.pipoca.desktop",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "bun sidecar.ts",
    "beforeBuildCommand": "bun sidecar.ts"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pipoca",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 400,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage"],
    "category": "DeveloperTool",
    "externalBin": ["binaries/pipoca"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
